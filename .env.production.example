# ============================================================
# Floo·Content — PRODUCTION Environment Variables
# ============================================================
# Production target: https://floo-ai.vercel.app
#
# This file is a TEMPLATE — copy each variable into Vercel:
#   Project → Settings → Environment Variables → "Production" scope
#
# DO NOT commit a populated copy. Real secrets live ONLY in:
#   - Vercel's encrypted env-var store (production)
#   - your local .env (development, gitignored)
#
# Lines marked  [SAME AS LOCAL]   = identical value to .env
# Lines marked  [DIFFERS]         = value MUST change for production
# Lines marked  [VERCEL AUTOSETS] = do NOT set manually, Vercel handles it
# Lines marked  [PROD ONLY]       = not needed for local dev
# ============================================================


# ----------------------------------------------------------
# APP
# ----------------------------------------------------------
NUXT_PUBLIC_APP_URL=https://floo-ai.vercel.app          # [DIFFERS]   local: http://localhost:3000
NUXT_PUBLIC_APP_NAME=Floo·Content                       # [SAME AS LOCAL]
# NODE_ENV                                              # [VERCEL AUTOSETS] do not set — Vercel forces "production"


# ----------------------------------------------------------
# SUPABASE  (one project shared by local + prod for now)
# ----------------------------------------------------------
NUXT_PUBLIC_SUPABASE_URL=https://xxumxffdukpshebypzur.supabase.co       # [SAME AS LOCAL]
NUXT_PUBLIC_SUPABASE_ANON_KEY=<paste anon key from Supabase → Settings → API>   # [SAME AS LOCAL]
SUPABASE_SERVICE_ROLE_KEY=<paste service_role key from Supabase → Settings → API> # [SAME AS LOCAL]
SUPABASE_DB_URL=postgresql://postgres.xxumxffdukpshebypzur:<DB-PASS>@aws-1-ap-south-1.pooler.supabase.com:6543/postgres  # [SAME AS LOCAL] — must be the POOLER URL on port 6543, never direct 5432
SUPABASE_JWT_SECRET=<paste from Supabase → Settings → API → JWT Settings>       # [SAME AS LOCAL]


# ----------------------------------------------------------
# GOOGLE OAUTH
# ----------------------------------------------------------
GOOGLE_CLIENT_ID=22951285233-m4h0n3opclqarpupsjjhnvr5ip6gc71m.apps.googleusercontent.com  # [SAME AS LOCAL] reuse existing Google OAuth client
GOOGLE_CLIENT_SECRET=<paste from Google Cloud Console>                                    # [SAME AS LOCAL]
# GOOGLE_REDIRECT_URI                                   # [NOT USED AT RUNTIME] purely documentation;
#                                                         the actual callback path is built by
#                                                         nuxt-auth-utils from the request host as
#                                                         /api/auth/callback. You only need to register
#                                                         https://floo-ai.vercel.app/api/auth/callback
#                                                         in Google Cloud Console → OAuth client.


# ----------------------------------------------------------
# SESSION (nuxt-auth-utils sealed cookie)
# ----------------------------------------------------------
SESSION_SECRET=3271c9627f2d91fc23a955a6ff08a10fc4a8de1d6724c046ec391fd888e587d0   # [DIFFERS] — newly generated for prod; do NOT reuse the local one

AI_PROVIDER=auto
EMBEDDINGS_MODEL=text-embedding-3-small

# ----------------------------------------------------------
# AI — PRIMARY: GLM
# ----------------------------------------------------------
GLM_API_KEY=<your real GLM key — replace local placeholder>     # [DIFFERS] local .env still has placeholder
GLM_API_BASE_URL=https://open.bigmodel.cn/api/paas/v4           # [SAME AS LOCAL]
GLM_MODEL=glm-4-flash                                           # [SAME AS LOCAL] — bump to glm-4-plus for prod quality if cost allows


# ----------------------------------------------------------
# AI — FALLBACKS (optional)
# ----------------------------------------------------------
OPENAI_API_KEY=<real key or leave unset>          # [DIFFERS]
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=<real key or leave unset>       # [DIFFERS]
ANTHROPIC_MODEL=claude-sonnet-4-20250514


# ----------------------------------------------------------
# SUPABASE STORAGE — S3 API (for direct uploads from server)
# ----------------------------------------------------------
SUPABASE_S3_ACCESS_KEY_ID=<from Supabase → Storage → S3 Access Keys>          # [PROD ONLY] not in current local .env — needed for upload routes
SUPABASE_S3_SECRET_ACCESS_KEY=<from Supabase → Storage → S3 Access Keys>      # [PROD ONLY]
SUPABASE_S3_ENDPOINT=https://xxumxffdukpshebypzur.supabase.co/storage/v1/s3   # [PROD ONLY]
SUPABASE_S3_REGION=ap-south-1                                                 # [PROD ONLY] match the Supabase project region


# ----------------------------------------------------------
# FILE STORAGE BUCKETS
# ----------------------------------------------------------
SUPABASE_STORAGE_BUCKET_ASSETS=brand-assets                   # [SAME AS LOCAL]
SUPABASE_STORAGE_BUCKET_AVATARS=avatars                       # [SAME AS LOCAL]
SUPABASE_STORAGE_BUCKET_ATTACHMENTS=message-attachments       # [SAME AS LOCAL]
NUXT_PUBLIC_STORAGE_CDN_URL=https://xxumxffdukpshebypzur.supabase.co/storage/v1/object/public  # [SAME AS LOCAL]
MAX_BRAND_ASSET_SIZE_MB=50                                    # [SAME AS LOCAL]
MAX_AVATAR_SIZE_MB=5                                          # [SAME AS LOCAL]
MAX_ATTACHMENT_SIZE_MB=25                                     # [SAME AS LOCAL]


# ----------------------------------------------------------
# EMAIL (Resend)
# ----------------------------------------------------------
RESEND_API_KEY=<real Resend API key>                          # [DIFFERS] local has placeholder
RESEND_FROM_EMAIL=noreply@floothink.com                       # [DIFFERS] must be on a Resend-VERIFIED domain
RESEND_FROM_NAME=Floo·Content                                 # [SAME AS LOCAL]


# ----------------------------------------------------------
# RATE LIMITING
# ----------------------------------------------------------
RATE_LIMIT_AI_REQUESTS_PER_MINUTE=20                          # [SAME AS LOCAL]


# ----------------------------------------------------------
# STRIPE  (Phase 7 — only when enabling billing)
# ----------------------------------------------------------
# STRIPE_SECRET_KEY=sk_live_...                               # [PROD ONLY] use live keys, NOT sk_test_
# NUXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...              # [PROD ONLY]
# STRIPE_WEBHOOK_SECRET=whsec_...                             # [PROD ONLY] from a webhook pointed at https://floo-ai.vercel.app/api/billing/webhook
# STRIPE_PRICE_ID_PRO=price_...                               # [PROD ONLY]
# STRIPE_PRICE_ID_TEAM=price_...                              # [PROD ONLY]


# ----------------------------------------------------------
# OPTIONAL: ANALYTICS
# ----------------------------------------------------------
# NUXT_PUBLIC_POSTHOG_KEY=phc_...
# NUXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com


# ============================================================
# QUICK DIFF — local (.env) vs production (this file)
# ============================================================
#
#   Variable                   Local                      Production
#   ─────────────────────────  ────────────────────────   ──────────────────────────
#   NUXT_PUBLIC_APP_URL        http://localhost:3000      https://floo-ai.vercel.app
#   NODE_ENV                   development                (Vercel autosets)
#   SESSION_SECRET             local-only secret          NEW prod secret (do not share)
#   RESEND_FROM_EMAIL          placeholder                verified domain
#   GLM_API_KEY                placeholder                real key
#   SUPABASE_S3_ACCESS_KEY_ID  not set                    REQUIRED for upload routes
#   SUPABASE_S3_SECRET_…       not set                    REQUIRED
#   SUPABASE_S3_ENDPOINT       not set                    REQUIRED
#   SUPABASE_S3_REGION         not set                    REQUIRED
#   Cookie `secure` flag       false (NODE_ENV=dev)       true (Vercel sets prod)
#
#   Everything else is identical (single Supabase project, single Google OAuth client).
#
# ============================================================
# REGISTER THESE URLS IN EXTERNAL SERVICES BEFORE FIRST DEPLOY
# ============================================================
#
#   Google Cloud Console → OAuth client → Authorized redirect URIs:
#     http://localhost:3000/api/auth/callback     (already there)
#     https://floo-ai.vercel.app/api/auth/callback  (ADD)
#
#   Google Cloud Console → OAuth client → Authorized JavaScript origins:
#     http://localhost:3000                        (already there)
#     https://floo-ai.vercel.app                   (ADD)
#
#   Supabase → Authentication → URL Configuration:
#     Site URL: https://floo-ai.vercel.app
#     Additional Redirect URLs (for preview deploys, optional):
#       https://floo-ai-*-<your-vercel-team>.vercel.app/api/auth/callback
#
#   Resend → Domains:
#     Verify whatever domain you use for RESEND_FROM_EMAIL (DNS: SPF, DKIM, return-path)
#
# ============================================================
