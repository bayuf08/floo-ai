# ============================================================
# Floo·Content — Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual credentials.
# See BACKEND-IMPLEMENTATION-PLAN.md for the full architecture.
# See the "HOW TO GET EACH KEY" section at the bottom of this file.
# ============================================================

# ----------------------------------------------------------
# APP
# ----------------------------------------------------------
NUXT_PUBLIC_APP_URL=http://localhost:3000
NUXT_PUBLIC_APP_NAME=Floo·Content
NODE_ENV=development

# ----------------------------------------------------------
# SUPABASE (Database, Auth, Storage, Realtime)
# ----------------------------------------------------------
NUXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NUXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your-service-role-key
SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres
SUPABASE_JWT_SECRET=your-jwt-secret

# ----------------------------------------------------------
# GOOGLE OAUTH (Social Login via Supabase Auth)
# ----------------------------------------------------------
GOOGLE_CLIENT_ID=123456789-abcdef.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback

# ----------------------------------------------------------
# AI — PRIMARY: GLM (ChatGLM / Zhipu AI)
# ----------------------------------------------------------
GLM_API_KEY=your-glm-api-key-here
GLM_API_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4-flash

# ----------------------------------------------------------
# AI — FALLBACK: OPENAI (Optional)
# ----------------------------------------------------------
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_BASE_URL=https://api.openai.com/v1

# ----------------------------------------------------------
# AI — FALLBACK: ANTHROPIC (Optional)
# ----------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ----------------------------------------------------------
# SUPABASE STORAGE — S3-COMPATIBLE API
# Found in: Supabase Dashboard → Storage → S3 Access Keys → New access key
# Use these when uploading files via the S3 SDK (@aws-sdk/client-s3).
# The endpoint below is fixed for your project — replace <project-ref>.
# ----------------------------------------------------------
SUPABASE_S3_ACCESS_KEY_ID=your-s3-access-key-id
SUPABASE_S3_SECRET_ACCESS_KEY=your-s3-secret-access-key
SUPABASE_S3_ENDPOINT=https://your-project-ref.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=ap-southeast-1

# ----------------------------------------------------------
# FILE STORAGE (Supabase Storage — all uploads go here)
# Three buckets: brand-assets (private), avatars (public),
# message-attachments (private). See BACKEND-IMPLEMENTATION-PLAN.md §2.5
# for bucket paths, access policies, and upload flows.
# ----------------------------------------------------------
SUPABASE_STORAGE_BUCKET_ASSETS=brand-assets
SUPABASE_STORAGE_BUCKET_AVATARS=avatars
SUPABASE_STORAGE_BUCKET_ATTACHMENTS=message-attachments
# Base URL for public bucket (avatars). Append /avatars/{userId}/{filename}
NUXT_PUBLIC_STORAGE_CDN_URL=https://your-project-ref.supabase.co/storage/v1/object/public
# Per-bucket file size limits (MB)
MAX_BRAND_ASSET_SIZE_MB=50
MAX_AVATAR_SIZE_MB=5
MAX_ATTACHMENT_SIZE_MB=25

# ----------------------------------------------------------
# EMAIL (Resend — for invites & notifications)
# ----------------------------------------------------------
RESEND_API_KEY=re_your-resend-api-key
RESEND_FROM_EMAIL=noreply@yourdomain.com
RESEND_FROM_NAME=Floo·Content

# ----------------------------------------------------------
# STRIPE (Future — billing & subscriptions)
# ----------------------------------------------------------
# STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
# STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
# STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
# STRIPE_PRICE_ID_FREE=price_free_plan_id
# STRIPE_PRICE_ID_PRO=price_pro_plan_id

# ----------------------------------------------------------
# RATE LIMITING & SECURITY
# ----------------------------------------------------------
RATE_LIMIT_AI_REQUESTS_PER_MINUTE=20
SESSION_SECRET=a-long-random-string-for-session-encryption

# ----------------------------------------------------------
# OPTIONAL: ANALYTICS
# ----------------------------------------------------------
# NUXT_PUBLIC_POSTHOG_KEY=phc_your-posthog-key
# NUXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com


# ============================================================
# HOW TO GET EACH KEY — Step by Step
# ============================================================
#
# ────────────────────────────────────────
# 1. SUPABASE (Database + Auth + Storage)
# ────────────────────────────────────────
#
#   a) Go to https://supabase.com and sign up / log in
#   b) Click "New Project", choose a name (e.g. "floo-content"),
#      set a strong database password, choose a region close to you
#   c) Wait for the project to provision (~2 minutes)
#   d) Go to Settings > API:
#      - "Project URL" → paste into NUXT_PUBLIC_SUPABASE_URL
#      - "anon public" key → paste into NUXT_PUBLIC_SUPABASE_ANON_KEY
#      - "service_role secret" key → paste into SUPABASE_SERVICE_ROLE_KEY
#        (NEVER expose this on the client side)
#   e) Go to Settings > Database:
#      - "Connection string" (URI) → paste into SUPABASE_DB_URL
#        (replace [YOUR-PASSWORD] with the database password you set)
#   f) Go to Settings > API > JWT Settings:
#      - "JWT Secret" → paste into SUPABASE_JWT_SECRET
#   g) Storage setup is covered separately in step 1b below
#
# ────────────────────────────────────────
# 1b. SUPABASE STORAGE BUCKETS
# ────────────────────────────────────────
#
#   All file uploads in Floo·Content go to Supabase Storage — no exceptions.
#   Create these 3 buckets in your Supabase project:
#
#   Bucket 1: brand-assets  (PRIVATE)
#     - Access: Private (RLS enforced — project membership required)
#     - Files served via server-generated signed URLs (1hr expiry)
#     - Path pattern: brand-assets/{projectId}/{uuid}.{ext}
#     - Max size: 50 MB (set MAX_BRAND_ASSET_SIZE_MB)
#     - Allowed types: images, video, PDF, DOCX, TXT, PPTX, XLSX, CSV
#
#   Bucket 2: avatars  (PUBLIC)
#     - Access: Public (anyone can read via CDN URL)
#     - Files served via NUXT_PUBLIC_STORAGE_CDN_URL/avatars/{userId}/{uuid}.{ext}
#     - Path pattern: avatars/{userId}/{uuid}.{ext}
#     - Max size: 5 MB (set MAX_AVATAR_SIZE_MB)
#     - Allowed types: image/* only
#     - Note: Google OAuth avatars use the Google URL directly — no upload needed
#             unless the user manually changes their profile photo
#
#   Bucket 3: message-attachments  (PRIVATE)
#     - Access: Private (RLS enforced — project membership required)
#     - Files served via server-generated signed URLs
#     - Path pattern: message-attachments/{projectId}/{messageId}/{uuid}.{ext}
#     - Max size: 25 MB (set MAX_ATTACHMENT_SIZE_MB)
#     - Lifecycle: files are eligible for cleanup after 30 days
#
#   To create buckets in Supabase:
#     - Go to Storage in the Supabase sidebar
#     - Click "New bucket" for each of the 3 above
#     - Set the correct public/private toggle for each
#     - Apply RLS policies from the migration file (20240101000001_rls_policies.sql)
#
# ────────────────────────────────────────
# 2. GOOGLE OAUTH (Login with Google)
# ────────────────────────────────────────
#
#   a) Go to https://console.cloud.google.com
#   b) Create a new project (or select existing)
#   c) Go to "APIs & Services" > "Credentials"
#   d) Click "Create Credentials" > "OAuth client ID"
#   e) If prompted, configure the OAuth consent screen first:
#      - App name: "Floo·Content"
#      - User support email: your email
#      - Authorized domains: your domain (or localhost for dev)
#      - Developer contact: your email
#      - Scopes: email, profile, openid
#      - Test users: add your own email for development
#   f) Back in Credentials, create "OAuth client ID":
#      - Application type: "Web application"
#      - Name: "Floo·Content Web"
#      - Authorized JavaScript origins: http://localhost:3000
#      - Authorized redirect URIs:
#        http://localhost:3000/api/auth/callback
#        https://your-project-ref.supabase.co/auth/v1/callback
#   g) Copy "Client ID" → GOOGLE_CLIENT_ID
#   h) Copy "Client secret" → GOOGLE_CLIENT_SECRET
#   i) ALSO configure in Supabase:
#      - Go to Supabase Dashboard > Authentication > Providers > Google
#      - Toggle ON
#      - Paste your Google Client ID and Client Secret there
#      - Save
#
# ────────────────────────────────────────
# 3. GLM API KEY (ChatGLM / Zhipu AI)
# ────────────────────────────────────────
#
#   a) Go to https://open.bigmodel.cn (Zhipu AI Open Platform)
#   b) Sign up with your email or phone number
#      (note: the interface is primarily in Chinese; use browser translate)
#   c) After email verification, log in
#   d) Go to "API Keys" (API密钥) in the dashboard sidebar
#   e) Click "Create API Key" (创建API Key)
#   f) Copy the key → paste into GLM_API_KEY
#   g) Available models:
#      - glm-4-flash (fast, cheaper — recommended for dev)
#      - glm-4-plus (more capable)
#      - glm-4 (balanced)
#      Check current pricing at https://open.bigmodel.cn/pricing
#   h) Free tier: New accounts typically get free credits
#      Check your balance at the dashboard home page
#
# ────────────────────────────────────────
# 4. OPENAI API KEY (Optional fallback)
# ────────────────────────────────────────
#
#   a) Go to https://platform.openai.com
#   b) Sign up / log in
#   c) Go to API Keys (https://platform.openai.com/api-keys)
#   d) Click "Create new secret key"
#   e) Name it (e.g. "floo-content-dev")
#   f) Copy the key → paste into OPENAI_API_KEY
#      (you only see it once — save it somewhere safe)
#   g) Add billing: Settings > Billing > Add payment method
#   h) Recommended model: gpt-4o-mini (fast + cheap) or gpt-4o (more capable)
#
# ────────────────────────────────────────
# 5. ANTHROPIC API KEY (Optional fallback)
# ────────────────────────────────────────
#
#   a) Go to https://console.anthropic.com
#   b) Sign up / log in
#   c) Go to API Keys in the sidebar
#   d) Click "Create Key"
#   e) Copy the key → paste into ANTHROPIC_API_KEY
#   f) Add billing: Settings > Billing > Add payment method
#   g) Recommended model: claude-sonnet-4-20250514 (balanced cost/performance)
#
# ────────────────────────────────────────
# 6. RESEND (Email sending)
# ────────────────────────────────────────
#
#   a) Go to https://resend.com and sign up
#   b) Go to API Keys (https://resend.com/api-keys)
#   c) Click "Create API Key"
#   d) Name: "floo-content", Permission: "Sending access"
#   e) Copy the key → paste into RESEND_API_KEY
#   f) For production: add + verify your domain:
#      - Go to Domains > Add Domain
#      - Add DNS records (MX, TXT, DKIM) as instructed
#      - Wait for verification (usually < 1 hour)
#      - Update RESEND_FROM_EMAIL to use your verified domain
#   g) Free tier: 100 emails/day, 3000/month — enough for development
#
# ────────────────────────────────────────
# 7. STRIPE (Future — billing)
# ────────────────────────────────────────
#
#   a) Go to https://dashboard.stripe.com and sign up
#   b) Stay in TEST MODE (toggle at top of dashboard)
#   c) Go to Developers > API Keys:
#      - "Publishable key" → STRIPE_PUBLISHABLE_KEY
#      - "Secret key" → STRIPE_SECRET_KEY
#   d) Go to Developers > Webhooks:
#      - Add endpoint: https://yourdomain.com/api/billing/webhook
#      - Select events: checkout.session.completed, customer.subscription.*
#      - Copy "Signing secret" → STRIPE_WEBHOOK_SECRET
#   e) Create products and prices in the Products section
#      - Copy price IDs → STRIPE_PRICE_ID_FREE, STRIPE_PRICE_ID_PRO
#
# ────────────────────────────────────────
# 8. SESSION_SECRET
# ────────────────────────────────────────
#
#   Generate a random 64-character string. Run in terminal:
#     openssl rand -hex 32
#   Paste the output into SESSION_SECRET
#
# ============================================================
